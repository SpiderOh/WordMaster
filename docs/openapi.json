  "components": {
    "schemas": {
      "Body_import_vocabulary_api_v1_vocabularies_import_post": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "name",
          "file"
        ],
        "title": "Body_import_vocabulary_api_v1_vocabularies_import_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportResponse": {
        "properties": {
          "vocabulary": {
            "$ref": "#/components/schemas/VocabularyRead"
          },
          "imported_count": {
            "type": "integer",
            "title": "Imported Count"
          },
          "row_errors": {
            "items": {
              "$ref": "#/components/schemas/RowErrorRead"
            },
            "type": "array",
            "title": "Row Errors"
          }
        },
        "type": "object",
        "required": [
          "vocabulary",
          "imported_count",
          "row_errors"
        ],
        "title": "ImportResponse"
      },
      "RowErrorRead": {
        "properties": {
          "row_number": {
            "type": "integer",
            "title": "Row Number"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "row_number",
          "code",
          "message"
        ],
        "title": "RowErrorRead"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VocabularyActiveUpdate": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "type": "object",
        "required": [
          "active"
        ],
        "title": "VocabularyActiveUpdate"
      },
      "VocabularyPriorityUpdate": {
        "properties": {
          "priority": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Priority"
          }
        },
        "type": "object",
        "required": [
          "priority"
        ],
        "title": "VocabularyPriorityUpdate"
      },
      "VocabularyRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "imported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Imported At"
          },
          "total_words": {
            "type": "integer",
            "title": "Total Words"
          },
          "active": {
            "type": "boolean",
            "title": "Active"
          },
          "priority": {
            "type": "integer",
            "title": "Priority"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "filename",
          "imported_at",
          "total_words",
          "active",
          "priority"
        ],
        "title": "VocabularyRead"
      },
      "VocabularyUpdate": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "type": "object",
        "title": "VocabularyUpdate"
      }
    }
