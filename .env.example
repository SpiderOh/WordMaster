WORDMASTER_APP_NAME=WordMaster API
WORDMASTER_APP_VERSION=0.1.0
WORDMASTER_DATABASE_URL=sqlite:///./data/wordmaster.db
WORDMASTER_AUTH_MODE=local
WORDMASTER_SECRET_KEY=replace-with-a-long-random-string
WORDMASTER_ACCESS_TOKEN_MINUTES=60
# Required when WORDMASTER_AUTH_MODE=server; use a password of at least 8 characters.
WORDMASTER_SERVER_USERNAME=owner
WORDMASTER_SERVER_PASSWORD=replace-with-a-long-password
# Optional override; local default is ./data/reden_vocabulary_6550.csv.
WORDMASTER_DEFAULT_VOCABULARY_PATH=
